<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="paws_pet_profile" resource="default" engine="innodb" comment="Customer Pet Profiles">
        <column xsi:type="int" name="pet_id" unsigned="true" nullable="false" identity="true" comment="Pet ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="name" length="64" nullable="false" comment="Pet Name"/>
        <column xsi:type="varchar" name="species" length="32" nullable="false" comment="Species Code"/>
        <column xsi:type="varchar" name="breed" length="128" nullable="true" comment="Breed"/>
        <column xsi:type="varchar" name="gender" length="16" nullable="true" comment="Gender Code"/>
        <column xsi:type="date" name="date_of_birth" nullable="true" comment="Date of Birth"/>
        <column xsi:type="decimal" name="weight_kg" scale="2" precision="6" unsigned="true" nullable="true"
                comment="Weight (kg)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="pet_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PAWS_PET_PROFILE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="paws_pet_profile" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <!-- One pet per name and species per customer. Also serves the customer_id FK and lookups. -->
        <constraint xsi:type="unique" referenceId="PAWS_PET_PROFILE_CUSTOMER_ID_NAME_SPECIES">
            <column name="customer_id"/>
            <column name="name"/>
            <column name="species"/>
        </constraint>
        <index referenceId="PAWS_PET_PROFILE_SPECIES_BREED" indexType="btree">
            <column name="species"/>
            <column name="breed"/>
        </index>
    </table>
</schema>
